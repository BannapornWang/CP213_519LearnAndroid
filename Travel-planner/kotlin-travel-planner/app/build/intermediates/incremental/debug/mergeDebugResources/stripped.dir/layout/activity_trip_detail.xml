<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- ── Header ── -->
    <LinearLayout
        android:id="@+id/layoutDetailHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="48dp"
        android:paddingBottom="14dp"
        android:background="@color/surface">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_media_previous"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/text_primary"
            android:contentDescription="Back"
            android:layout_marginEnd="8dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textTripTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍"
                    android:textSize="11sp"
                    android:layout_marginEnd="3dp" />

                <TextView
                    android:id="@+id/textHeaderDest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/textStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- ── Meta info card ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="0dp"
        android:background="@color/surface">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardElevation="1dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/border"
            app:cardBackgroundColor="@color/background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp">

                <!-- Dates -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📅 "
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/textMetaDates"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Divider -->
                <View android:layout_width="1dp" android:layout_height="28dp"
                    android:background="@color/border"
                    android:layout_marginStart="8dp" android:layout_marginEnd="8dp" />

                <!-- Days -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🕐 "
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/textMetaDays"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Divider -->
                <View android:layout_width="1dp" android:layout_height="28dp"
                    android:background="@color/border"
                    android:layout_marginStart="8dp" android:layout_marginEnd="8dp" />

                <!-- Spent -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👛 "
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/textMetaSpent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/accent"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- ── Tab bar ── -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/surface"
        android:layout_marginTop="4dp"
        app:tabMode="scrollable"
        app:tabGravity="start"
        app:tabSelectedTextColor="@color/primary"
        app:tabTextColor="@color/text_secondary"
        app:tabIndicatorColor="@color/primary"
        app:tabIndicatorHeight="2dp"
        app:tabPaddingStart="4dp"
        app:tabPaddingEnd="4dp" />

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/border" />

    <!-- ── Scrollable content ── -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ════ ITINERARY TAB ════ -->
            <LinearLayout
                android:id="@+id/layoutItinerary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingBottom="10dp">
                    
                    <HorizontalScrollView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:scrollbars="none">
                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupDays"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            app:singleSelection="true"
                            app:chipSpacingHorizontal="8dp" />
                    </HorizontalScrollView>

                    <TextView
                        android:id="@+id/btnEditItinerary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Edit"
                        android:textColor="@color/accent"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:paddingStart="12dp"
                        android:paddingEnd="4dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOptimizeRoute"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="✦  Optimize Route"
                    android:textColor="@color/primary"
                    android:layout_marginBottom="12dp"
                    app:strokeColor="@color/primary" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerPlaces"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <!-- Edit Mode RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerEditItinerary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ════ BUDGET TAB ════ -->
            <LinearLayout
                android:id="@+id/layoutBudget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Budget Overview Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="1dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/border"
                    app:cardBackgroundColor="@color/surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <!-- Overview header -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Budget Overview"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/textRemaining"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_pill"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:paddingTop="4dp"
                                android:paddingBottom="4dp"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="@color/success" />
                        </LinearLayout>

                        <!-- Totals row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="14dp">

                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="Spent" android:textColor="@color/text_secondary"
                                    android:textSize="11sp" android:layout_marginBottom="2dp" />
                                <TextView android:id="@+id/textBudgetSpent"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:textColor="@color/primary"
                                    android:textSize="22sp" android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="  /  "
                                android:textColor="@color/border"
                                android:textSize="22sp"
                                android:layout_marginTop="12dp" />

                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="Budget" android:textColor="@color/text_secondary"
                                    android:textSize="11sp" android:layout_marginBottom="2dp" />
                                <TextView android:id="@+id/textBudgetTotal"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:textColor="@color/text_primary"
                                    android:textSize="22sp" android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Divider -->
                        <View android:layout_width="match_parent" android:layout_height="1dp"
                            android:background="@color/border" android:layout_marginBottom="14dp" />

                        <!-- Category bars -->
                        <!-- Transport -->
                        <LinearLayout android:id="@+id/rowTransport"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">
                            <LinearLayout android:layout_width="100dp" android:layout_height="wrap_content"
                                android:orientation="horizontal" android:gravity="center_vertical">
                                <TextView android:layout_width="24dp" android:layout_height="24dp"
                                    android:id="@+id/iconTransport"
                                    android:gravity="center" android:text="✈"
                                    android:background="@drawable/bg_chip_secondary"
                                    android:textSize="11sp" android:layout_marginEnd="8dp" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="Transport" android:textColor="@color/text_secondary"
                                    android:textSize="12sp" />
                            </LinearLayout>
                            <FrameLayout android:layout_width="0dp" android:layout_height="6dp"
                                android:layout_weight="1" android:layout_marginStart="8dp"
                                android:background="@drawable/bg_progress_track">
                                <View android:id="@+id/barTransport"
                                    android:layout_width="0dp" android:layout_height="match_parent"
                                    android:background="@drawable/bg_progress_fill" />
                            </FrameLayout>
                            <TextView android:id="@+id/textBudgetTransport"
                                android:layout_width="72dp" android:layout_height="wrap_content"
                                android:gravity="end" android:textColor="@color/text_primary"
                                android:textSize="12sp" android:textStyle="bold"
                                android:layout_marginStart="8dp" />
                        </LinearLayout>

                        <!-- Food -->
                        <LinearLayout android:id="@+id/rowFood"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">
                            <LinearLayout android:layout_width="100dp" android:layout_height="wrap_content"
                                android:orientation="horizontal" android:gravity="center_vertical">
                                <TextView android:layout_width="24dp" android:layout_height="24dp"
                                    android:gravity="center" android:text="🍽"
                                    android:background="@drawable/bg_chip_food"
                                    android:textSize="11sp" android:layout_marginEnd="8dp" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="Food" android:textColor="@color/text_secondary"
                                    android:textSize="12sp" />
                            </LinearLayout>
                            <FrameLayout android:layout_width="0dp" android:layout_height="6dp"
                                android:layout_weight="1" android:layout_marginStart="8dp"
                                android:background="@drawable/bg_progress_track">
                                <View android:id="@+id/barFood"
                                    android:layout_width="0dp" android:layout_height="match_parent"
                                    android:background="@drawable/bg_progress_food" />
                            </FrameLayout>
                            <TextView android:id="@+id/textBudgetFood"
                                android:layout_width="72dp" android:layout_height="wrap_content"
                                android:gravity="end" android:textColor="@color/text_primary"
                                android:textSize="12sp" android:textStyle="bold"
                                android:layout_marginStart="8dp" />
                        </LinearLayout>

                        <!-- Attraction -->
                        <LinearLayout android:id="@+id/rowAttraction"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">
                            <LinearLayout android:layout_width="100dp" android:layout_height="wrap_content"
                                android:orientation="horizontal" android:gravity="center_vertical">
                                <TextView android:layout_width="24dp" android:layout_height="24dp"
                                    android:gravity="center" android:text="📷"
                                    android:background="@drawable/bg_chip_attraction"
                                    android:textSize="11sp" android:layout_marginEnd="8dp" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="Attraction" android:textColor="@color/text_secondary"
                                    android:textSize="12sp" />
                            </LinearLayout>
                            <FrameLayout android:layout_width="0dp" android:layout_height="6dp"
                                android:layout_weight="1" android:layout_marginStart="8dp"
                                android:background="@drawable/bg_progress_track">
                                <View android:id="@+id/barAttraction"
                                    android:layout_width="0dp" android:layout_height="match_parent"
                                    android:background="@drawable/bg_progress_attraction" />
                            </FrameLayout>
                            <TextView android:id="@+id/textBudgetAttraction"
                                android:layout_width="72dp" android:layout_height="wrap_content"
                                android:gravity="end" android:textColor="@color/text_primary"
                                android:textSize="12sp" android:textStyle="bold"
                                android:layout_marginStart="8dp" />
                        </LinearLayout>

                        <!-- Accommodation -->
                        <LinearLayout android:id="@+id/rowAccommodation"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">
                            <LinearLayout android:layout_width="100dp" android:layout_height="wrap_content"
                                android:orientation="horizontal" android:gravity="center_vertical">
                                <TextView android:layout_width="24dp" android:layout_height="24dp"
                                    android:gravity="center" android:text="🛏"
                                    android:background="@drawable/bg_chip_accommodation"
                                    android:textSize="11sp" android:layout_marginEnd="8dp" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="Hotel" android:textColor="@color/text_secondary"
                                    android:textSize="12sp" />
                            </LinearLayout>
                            <FrameLayout android:layout_width="0dp" android:layout_height="6dp"
                                android:layout_weight="1" android:layout_marginStart="8dp"
                                android:background="@drawable/bg_progress_track">
                                <View android:id="@+id/barAccommodation"
                                    android:layout_width="0dp" android:layout_height="match_parent"
                                    android:background="@drawable/bg_progress_accommodation" />
                            </FrameLayout>
                            <TextView android:id="@+id/textBudgetAccommodation"
                                android:layout_width="72dp" android:layout_height="wrap_content"
                                android:gravity="end" android:textColor="@color/text_primary"
                                android:textSize="12sp" android:textStyle="bold"
                                android:layout_marginStart="8dp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Expenses section header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Expenses"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddExpense"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="+ Add"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        app:backgroundTint="@color/primary" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerExpenses"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>

            <!-- ════ BOOKINGS TAB ════ -->
            <LinearLayout
                android:id="@+id/layoutBookings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView android:id="@+id/textBookingCount"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textStyle="bold" android:textSize="18sp"
                    android:textColor="@color/text_primary" android:layout_marginBottom="12dp" />
                <LinearLayout android:id="@+id/linearBookings"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- ════ RECORD TAB ════ -->
            <LinearLayout
                android:id="@+id/layoutRecord"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="1dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/border"
                    app:cardBackgroundColor="@color/surface">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="18dp">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Trip Summary" android:textStyle="bold"
                            android:textSize="15sp" android:textColor="@color/text_primary"
                            android:layout_marginBottom="14dp" />

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:layout_marginBottom="8dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Destination" android:textColor="@color/text_secondary" android:textSize="13sp" />
                            <TextView android:id="@+id/textSummaryDestination"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:layout_marginBottom="8dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Duration" android:textColor="@color/text_secondary" android:textSize="13sp" />
                            <TextView android:id="@+id/textSummaryDays"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:layout_marginBottom="8dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Places Visited" android:textColor="@color/text_secondary" android:textSize="13sp" />
                            <TextView android:id="@+id/textSummaryPlaces"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:layout_marginBottom="14dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Bookings" android:textColor="@color/text_secondary" android:textSize="13sp" />
                            <TextView android:id="@+id/textSummaryBookings"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" />
                        </LinearLayout>

                        <View android:layout_width="match_parent" android:layout_height="1dp"
                            android:background="@color/border" android:layout_marginBottom="14dp" />

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Rate this Trip" android:textStyle="bold"
                            android:textSize="14sp" android:textColor="@color/text_primary"
                            android:layout_marginBottom="8dp" />

                        <RatingBar android:id="@+id/ratingBar"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:numStars="5" android:stepSize="1"
                            android:progressTint="@color/accent"
                            android:layout_marginBottom="14dp" />

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Trip Mood" android:textStyle="bold"
                            android:textSize="14sp" android:textColor="@color/text_primary"
                            android:layout_marginBottom="8dp" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupMood"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:singleSelection="true"
                            app:chipSpacingHorizontal="6dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
